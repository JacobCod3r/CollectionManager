<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CollectionManager.Views.CollectionItemEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Element kolekcji"
    BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.Resources>
        <StyleSheet Source="/Resources/Styles/app.css" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label
                Text="{Binding PageTitle}"
                StyleClass="pageTitle" />

            <Label Text="Nazwa" TextColor="{StaticResource TextColor}" />
            <Entry Text="{Binding Name}" />

            <Label Text="Cena" TextColor="{StaticResource TextColor}" />
            <Entry Keyboard="Numeric" Text="{Binding PriceText}" />

            <Label Text="Status" TextColor="{StaticResource TextColor}" />
            <Picker
                Title="Wybierz status"
                ItemsSource="{Binding Statuses}"
                SelectedItem="{Binding SelectedStatus}" />

            <Label Text="Ocena (1-10)" TextColor="{StaticResource TextColor}" />
            <Stepper Minimum="1" Maximum="10" Increment="1" Value="{Binding Rating}" />
            <Label Text="{Binding Rating, StringFormat='Aktualna ocena: {0}/10'}" TextColor="{StaticResource MutedTextColor}" />

            <Label Text="Komentarz" TextColor="{StaticResource TextColor}" />
            <Editor
                Placeholder="Komentarz"
                AutoSize="TextChanges"
                Text="{Binding Comment}"
                HeightRequest="100" />

            <Button
                Text="Zapisz"
                Command="{Binding SaveCommand}"
                BackgroundColor="{StaticResource PrimaryColor}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>